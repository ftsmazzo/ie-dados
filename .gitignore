data/raw/ibge/populacao/*
!data/raw/ibge/populacao/README.md
data/raw/ibge/pib_municipios/*
!data/raw/ibge/pib_municipios/README.md
!data/raw/atlas/
data/raw/atlas/*
!data/raw/atlas/idhm/
data/raw/atlas/idhm/*
!data/raw/atlas/idhm/README.md
!data/raw/tse/
data/raw/tse/*
!data/raw/tse/urna/
data/raw/tse/urna/*
!data/raw/tse/urna/README.md
!data/raw/tse/prestacao/
data/raw/tse/prestacao/*
!data/raw/tse/prestacao/README.md

data/processed/*
!data/processed/.gitkeep

# Secrets e ambiente
.env
.env.*
!.env.example
*.local

